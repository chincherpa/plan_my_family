# Supabase-Projektzugang.
# Dashboard → Project Settings → API Keys
#
# Publishable Key (sb_publishable_…): ist öffentlich und wird in den Browser ausgeliefert.
# Zugriff regelt die Row Level Security, nicht das Verstecken dieses Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Übergang: der alte "anon"-Key wird nur noch gelesen, wenn der Publishable Key fehlt.
# Nach der Umstellung entfernen.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret Key (sb_secret_…) wird von der App NICHT benötigt, weil sie keine Admin-Aufrufe macht.
# Nie als NEXT_PUBLIC_-Variable setzen und nie an den Browser geben.
# SUPABASE_SECRET_KEY=sb_secret_your-key

# Gemeinsames Familien-Login: E-Mail des Familien-Kontos in Supabase (nur Server, nie NEXT_PUBLIC_).
# Auf der Login-Seite wird nur das Passwort abgefragt.
FAMILY_LOGIN_EMAIL=familie-login@example.com

# Rezepte-App (zweites Supabase-Projekt, geteilte Mahlzeiten-Liste).
# Nur Server: wird ausschließlich in Server Actions gelesen (src/lib/recipes/admin.ts).
# Der Service-Role-Key umgeht RLS — nie als NEXT_PUBLIC_-Variable setzen.
# (Die Namen beginnen mit RECIPES_, nicht mit NEXT_PUBLIC_, und werden daher nicht ausgeliefert.)
RECIPES_NEXT_PUBLIC_SUPABASE_URL=https://your-recipes-ref.supabase.co
RECIPES_NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Termine per Sprache (POST /api/appointments/from-text): Claude extrahiert Titel, Datum, Uhrzeit.
# Nur Server — nie als NEXT_PUBLIC_-Variable setzen.
ANTHROPIC_API_KEY=sk-ant-your-key
