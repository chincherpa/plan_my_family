# Supabase-Projektzugang.
# Dashboard → Project Settings → API Keys
#
# Publishable Key (sb_publishable_…): ist öffentlich und wird in den Browser ausgeliefert.
# Zugriff regelt die Row Level Security, nicht das Verstecken dieses Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Übergang: der alte "anon"-Key wird nur noch gelesen, wenn der Publishable Key fehlt.
# Nach der Umstellung entfernen.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret Key (sb_secret_…) wird von der App NICHT benötigt, weil sie keine Admin-Aufrufe macht.
# Nie als NEXT_PUBLIC_-Variable setzen und nie an den Browser geben.
# SUPABASE_SECRET_KEY=sb_secret_your-key
